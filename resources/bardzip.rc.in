#include <windows.h>

// Generated by CMake from resources/bardzip.rc.in. Only ASCII here: the
// resource compiler reads this file in the system code page.

// The lowest numeric icon id is the one Explorer and the taskbar show.
1 ICON "@BARDZIP_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Viole1"
            VALUE "FileDescription", "BardZip - turn any file into a poem and back"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "bardzip"
            VALUE "LegalCopyright", "Copyright (c) 2026 Viole1. MIT License."
            VALUE "OriginalFilename", "bardzip.exe"
            VALUE "ProductName", "BardZip"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "https://github.com/Viole1/bard-zip"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
